# RDS MySQL metadata DB
KIDOGKIDOG_DB_BACKEND=mysql
MYSQL_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=kidogkidog

# ChromaDB vector store
# Use these when API/worker should share a ChromaDB server.
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=petcam_frames
