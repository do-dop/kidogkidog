CELERY_BROKER_URL=amqp://{{ rabbitmq_user }}:{{ rabbitmq_password }}@rabbitmq:5672/{{ rabbitmq_vhost }}
GCS_BUCKET_NAME={{ gcs_bucket_name }}
CHROMA_HOST={{ chroma_host }}
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION={{ chroma_collection }}
MYSQL_HOST=cloudsql-proxy
MYSQL_PORT=3306
MYSQL_USER={{ mysql_user }}
MYSQL_PASSWORD={{ mysql_password }}
MYSQL_DATABASE={{ mysql_database }}
OPENAI_API_KEY={{ openai_api_key | default('') }}
GEMINI_API_KEY={{ gemini_api_key | default('') }}
# frames(기본) | video | both. both는 영상 방식 결과를 DB에 쓰지 않고 /tmp/video_event_shadow(호스트 video-event-shadow)에만 남긴다.
BEHAVIOR_EVENT_SOURCE={{ behavior_event_source }}
METRICS_ENABLED=true
METRICS_PORT=8002
